<!-- Ultimate Mortal Kombat 3 Plus Dedicated profile for the shared cabinet-confirmed Wolf/DCS source lineage. UMK3 Plus retains the proven UMK3 six-button controls and 0xFD7D DSW layout, selects the development-512 PIC response, and structures the UMK3 architecture. ROM data is user-supplied and CRC-checked. -->
<misterromdescription>
    <about author="rejectedcoins / dual-index graphic overlay split fix"/>
    <rotation>horizontal</rotation>
    <name>Ultimate Mortal Kombat 3 Plus (Beta 2)</name>
    <setname>umk3pb2</setname>
    <mameversion>0280</mameversion>
    <year>2017</year>
    <manufacturer>Hack (TehDrewsus)</manufacturer>
    <players>2</players>
    <rbf>WolfUnit_20260730</rbf>
    <region>World</region>

    <!-- Wolf master profile 2: UMK3 controls and captured 463 PIC response. -->
    <rom index="3" md5="None"><part>02</part></rom>

    <!-- index 0: Main CPU / Program ROM Hack Core -->
    <rom index="0" zip="umk3pb2.zip" md5="None">
        <part name="umk3plus20220307.u54"/>
        <part name="umk3plus20220307.u63"/>
    </rom>

    <!-- index 1: Unmodified Base Graphics Loop (Guarantees Perfect Text & MK3 Characters) -->
    <rom index="1" zip="umk3pb2.zip" md5="None">
        <!-- Main Game Logic/Background ROMs -->
        <part name="l1_mortal_kombat_3_u133_game_rom.u133"/>
        <part name="l1_mortal_kombat_3_u132_game_rom.u132"/>
        <part name="l1_mortal_kombat_3_u131_game_rom.u131"/>
        <part name="l1_mortal_kombat_3_u130_game_rom.u130"/>
        <part name="l1_mortal_kombat_3_u129_game_rom.u129"/>
        <part name="l1_mortal_kombat_3_u128_game_rom.u128"/>
        <part name="l1_mortal_kombat_3_u127_game_rom.u127"/>
        <part name="l1_mortal_kombat_3_u126_game_rom.u126"/>
        <part name="l1_mortal_kombat_3_u125_game_rom.u125"/>
        <part name="l1_mortal_kombat_3_u124_game_rom.u124"/>
        <part name="l1_mortal_kombat_3_u123_game_rom.u123"/>
        <part name="l1_mortal_kombat_3_u122_game_rom.u122"/>

        <!-- Upper Video Image Graphics ROMs -->
        <part name="umk-u121.bin"/>
        <part name="umk-u120.bin"/>
        <part name="umk-u119.bin"/>
        <part name="umk-u118.bin"/>

        <!-- Foundational Base Sockets (Restores 100% Perfect Fonts) -->
        <part name="umk-u113.bin"/>
        <part name="umk-u112.bin"/>
        <part name="umk-u111.bin"/>
        <part name="umk-u110.bin"/>
        <part name="umk-u117.bin"/>
        <part name="umk-u116.bin"/>
        <part name="umk-u115.bin"/>
        <part name="umk-u114.bin"/>
    </rom>


    <!-- index 2: DCS1 Audio System (Standardized Parameter Alignment) -->
    <rom index="2" zip="umk3pb2.zip" md5="None">
        <part name="umk3plus20220307.u2" offset="0x000000"/>
        <part name="l1_mortal_kombat_3_u3_music_spch.u3"/>
        <part name="l1_mortal_kombat_3_u4_music_spch.u4"/>
        <part name="l1_mortal_kombat_3_u5_music_spch.u5"/>
    </rom>

    <!-- index 4: Hardwired Security Hardware Mapping Slot -->
    <rom index="4" zip="umk3pb2.zip" md5="None">
        <part name="463_mk3_ultimate.u64"/>
    </rom>

    <nvram index="5" size="49152"/>

    <!-- UMK3 6-button fighting layout. Matches Arcade-SmashTV.sv CONF_STR J1. -->
    <buttons names="High Punch,Low Punch,Block,High Kick,Low Kick,Run,Start,Coin"
             default="X,A,R,Y,B,L,Start,Select" count="6"/>
</misterromdescription>
